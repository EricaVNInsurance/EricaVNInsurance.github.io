{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ericavn-learning-assistant",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "https://ericavninsurance.github.io"
  },
  "ratelimits": [
    { "name": "CHAT_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
    { "name": "CHAT_GLOBAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } }
  ]
}
