{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed minimal contact intake; server implementation pending",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fullName",
    "phone",
    "email",
    "state",
    "zip",
    "topic",
    "preferredTime",
    "timeZone",
    "phonePermission",
    "emailPermission",
    "smsPermission",
    "consentVersion",
    "consentText",
    "emailPermissionText",
    "privacyVersion",
    "sourcePath"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "fullName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+1[2-9][0-9]{2}[2-9][0-9]{6}$"
    },
    "email": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "email",
          "maxLength": 254
        }
      ]
    },
    "state": {
      "enum": [
        "AR",
        "AZ",
        "CO",
        "FL",
        "GA",
        "IL",
        "LA",
        "MD",
        "MI",
        "MN",
        "MS",
        "NC",
        "NJ",
        "NM",
        "NV",
        "OH",
        "OK",
        "OR",
        "SD"
      ]
    },
    "zip": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        }
      ]
    },
    "topic": {
      "enum": [
        "new",
        "review",
        "prescriptions",
        "benefits",
        "enrollment",
        "question"
      ]
    },
    "preferredTime": {
      "enum": [
        null,
        "morning",
        "afternoon",
        "evening"
      ]
    },
    "timeZone": {
      "enum": [
        null,
        "America/New_York",
        "America/Chicago",
        "America/Denver",
        "America/Phoenix",
        "America/Los_Angeles",
        "America/Anchorage",
        "Pacific/Honolulu"
      ]
    },
    "phonePermission": {
      "const": true
    },
    "emailPermission": {
      "type": "boolean"
    },
    "smsPermission": {
      "const": false
    },
    "consentVersion": {
      "type": "string",
      "maxLength": 100
    },
    "consentText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "emailPermissionText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "privacyVersion": {
      "type": "string",
      "maxLength": 100
    },
    "sourcePath": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^/[A-Za-z0-9/_-]+\\.html$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "emailPermission": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "preferredTime": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "timeZone": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$comment": "Validate the approved consent/privacy versions and exact wording server-side. Validate actual licenses/readiness separately. Store server timestamp and consent hash. An Origin header is not identity verification."
}
